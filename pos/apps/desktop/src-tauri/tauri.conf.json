{
  "build": {
    "beforeDevCommand": "pnpm --filter @retailflow/web dev",
    "devPath": "http://localhost:3000",
    "beforeBuildCommand": "",
    "distDir": "../../web/out",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "RetailFlow POS",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": true,
        "open": true
      },
      "fs": {
        "all": true,
        "scope": ["$APPDATA/**", "$DESKTOP/**", "**"]
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.retailflow.pos",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "RetailFlow POS - Modern Retail Point of Sale",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true
      }
    ],
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEQ0QyNEVFOUU2N0ZGMjMKUldSNkM3NUVGZ0F0RzE4V2VNVVpYdkpvRzRzTWpQdVU3U01Odm12MmtmY2ZkVFNjVUVNVDlhR2IK",
      "endpoints": [
        "https://raw.githubusercontent.com/Juhamim/retailpos/main/releases/latest.json"
      ]
    }
  }
}