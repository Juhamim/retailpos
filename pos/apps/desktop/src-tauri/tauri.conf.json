{
  "build": {
    "beforeDevCommand": "pnpm --filter @retailflow/web dev",
    "devPath": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @retailflow/web build:export",
    "distDir": "../../web/out"
  },
  "package": {
    "productName": "RetailFlow POS",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": true,
        "scope": ["$APPDATA/**", "$DESKTOP/**"]
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.retailflow.pos",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "RetailFlow POS - Modern Retail Point of Sale",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true
      }
    ]
  }
}