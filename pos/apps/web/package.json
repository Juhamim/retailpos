{
  "name": "@retailflow/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:host": "next dev -H 0.0.0.0 -p 3000",
    "dev:clean": "powershell -Command \"Get-NetTCPConnection -LocalPort 3000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\" && next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "build:export": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@retailflow/business-core": "workspace:*",
    "@retailflow/database": "workspace:*",
    "@retailflow/shared-types": "workspace:*",
    "@retailflow/sync-engine": "workspace:*",
    "@retailflow/ui": "workspace:*",
    "@retailflow/validation": "workspace:*",
    "@tauri-apps/api": "^1.6.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.445.0",
    "next": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.0"
  }
}
